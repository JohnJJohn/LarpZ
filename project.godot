; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LarpZ"
run/main_scene="uid://df7w6yep880vq"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="res://Resouces/Textures/icon.svg"

[autoload]

BTGlobalMetrics="*res://addons/takobi_ai/editor/BTGlobalMetrics.cs"
AudioHost="*res://addons/audio_service/core/AudioHost.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="LarpZ"

[editor_plugins]

enabled=PackedStringArray("res://addons/audio_service/plugin.cfg", "res://addons/takobi_ai/plugin.cfg")

[file_customization]

folder_colors={
"res://Resouces/": "green",
"res://Resouces/Audio/": "red",
"res://Resouces/Textures/": "orange",
"res://Scenes/": "yellow",
"res://Scripts/": "teal"
}

[global_group]

Player="the player"

